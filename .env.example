# =============================================================================
# WhatsApp customer-support bot - environment configuration
# Copy to .env and fill in the blanks:  cp .env.example .env
#
# Every variable here is read by app.py. On Vercel, set the same names as
# project environment variables; .env is only used for local runs.
# Check what the app sees at any time with:  GET /health
# =============================================================================

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# -----------------------------------------------------------------------------
# Meta Developer dashboard -> your app -> WhatsApp -> API Setup.
# The temporary token expires in 24h; create a System User token in
# Business Settings for a permanent one.
WHATSAPP_ACCESS_TOKEN=

# Meta Developer dashboard -> WhatsApp -> API Setup -> "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=

# Generate locally: openssl rand -hex 32
# Any string you choose; paste the same value into Meta Developer dashboard ->
# WhatsApp -> Configuration -> Webhook -> "Verify token". app.py echoes the
# challenge on GET /webhook only when this matches.
WHATSAPP_VERIFY_TOKEN=

# Meta Developer dashboard -> App settings -> Basic -> "App secret" (Show).
# Validates the X-Hub-Signature-256 header on every incoming webhook. There is
# no bypass: without this, POST /webhook answers 403.
WHATSAPP_APP_SECRET=

WHATSAPP_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# Gemini
# -----------------------------------------------------------------------------
# aistudio.google.com/apikey
# Leave the Google Cloud project without a billing account and the free tier
# cannot be charged: past the quota the API returns 429 and app.py answers with
# BOT_BUSY_REPLY. Limits and usage: aistudio.google.com/rate-limit
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Bot behaviour
# -----------------------------------------------------------------------------
# The model that answers customers. Thinking level trades latency for depth:
# minimal | low | medium | high. Keep it low so the reply is sent before Meta
# gives up on the webhook and retries the delivery.
BOT_MODEL=gemini-3.8-flash
BOT_THINKING_LEVEL=low
BOT_MAX_TOKENS=1024
BOT_TIMEOUT_SECONDS=20

# Gemini holds the transcript, so there is no history size to configure: app.py
# caches only the last interaction id per customer, and a cold start on the
# host drops it, which starts a new thread.

# Pipeline test: when set, every incoming message is answered with exactly this
# text and Gemini is never called (GEMINI_API_KEY may stay empty). Use it to
# prove the Meta -> webhook -> reply loop works, then clear it to go live.
BOT_FIXED_REPLY=

# Replaces the built-in support persona in app.py when set.
BOT_SYSTEM_PROMPT=

# The canned replies also have defaults in app.py, overridable here:
# BOT_ERROR_REPLY, BOT_BUSY_REPLY, BOT_REFUSAL_REPLY, BOT_UNSUPPORTED_REPLY

BOT_LOG_LEVEL=INFO
